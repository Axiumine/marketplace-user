exports[`ResetRequestForm confirmation > matches the snapshot 1`] = `
<div
  class="flex flex-col gap-3"
>
  <p
    class="rounded-box border px-3 py-2 text-sm border-app-ok/40 bg-app-ok/10 text-app-ok"
    role="status"
  >
    If that address is registered, a reset link is on its way.
  </p>
  <p
    class="text-sm text-slate-600"
  >
    ⚠️ The link expires 
    <strong>
      60 minutes
    </strong>
     after it is sent — much sooner than an activation link. An expired one fails with the same message as a wrong one, so if in doubt, ask for a new link rather than retrying the old one.
  </p>
</div>
`;
