{
	"name": "marketplace-user",
	"description": "Marketplace — public site and customer area (User)",
	"license": "UNLICENSED",
	"author": "Giovanni Manzoni <dev@giovannimanzoni.com> (https://www.giovannimanzoni.com)",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/Marketplace-Org/marketplace-user.git"
	},
	"type": "module",
	"private": true,
	"engines": {
		"node": "^24.18.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "yarn codegen && tsc --noEmit && vite build",
		"start": "node serve.mjs",
		"preview": "vite preview",
		"codegen": "graphql-codegen --config codegen.ts",
		"codegen:watch": "graphql-codegen --config codegen.ts --watch",
		"typecheck": "tsc --noEmit",
		"lint": "eslint --fix . && prettier --write .",
		"lint:check": "eslint . && prettier --check .",
		"test": "TZ=UTC vitest run",
		"test:watch": "TZ=UTC vitest",
		"test:cov": "TZ=UTC vitest run --coverage",
		"test:mutation": "TZ=UTC stryker run",
		"update": "yarn upgrade-interactive --latest --network-timeout 100000",
		"prepare": "git config core.hooksPath .githooks || true"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.6.0",
		"@sentry/react": "^10.69.0",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/react-start": "^1.168.36",
		"@urql/core": "^6.0.3",
		"@urql/exchange-auth": "^3.0.0",
		"graphql": "^16.14.2",
		"maplibre-gl": "^6.1.0",
		"pmtiles": "^4.4.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.84.0",
		"srvx": "^0.11.22",
		"urql": "^5.0.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@graphql-codegen/cli": "^7.2.0",
		"@graphql-codegen/client-preset": "^6.1.0",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/vitest-runner": "^9.6.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.0",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"globals": "^17.8.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
