# Dependencies and build output — not ours to format.
node_modules/
dist/
coverage/
reports/
.stryker-tmp/

# The package manager owns these; reformatting them fights it on every install.
package.json
yarn.lock

# graphql-codegen output. Regenerated by `yarn codegen`; formatting it would be undone
# on the next run and would show up as noise in every diff that touches an operation.
src/gql/

# The route tree, rewritten by the TanStack Start plugin on every dev-server start and every
# build. `quoteStyle: 'single'` / `semicolons: false` in vite.config.ts already make the
# generator emit it matching .prettierrc — this line is the belt to that pair of braces, and
# the reason it is needed at all is that the generator's formatting is not a contract.
# ⚠️ This is a per-repo line. The other two frontends hand-write their route tree.
src/routeTree.gen.ts

# Written by `gitnexus analyze` and by the skills installer on every run. .claude/skills/*
# are symlinks into .agents/, so formatting them would write straight through the link.
.agents/
.claude/
.gitnexus/
skills-lock.json

# Markdown is excluded on purpose, not by oversight: `proseWrap: "never"` collapses every
# hand-wrapped paragraph in CLAUDE.md, COVERAGE.md and README.md onto a single line. The
# prose in this repo is wrapped deliberately and is meant to stay readable in a diff.
*.md
