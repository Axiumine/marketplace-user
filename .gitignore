# Vite
.vite/
dev-dist/

# TanStack Start scratch and Nitro output. `.tanstack/tmp` holds nothing but empty directories
# today, which git would not have committed anyway — the entry is here so it stays uncommitted
# once it holds something. `src/routeTree.gen.ts` is deliberately NOT ignored: `yarn build` runs
# `tsc --noEmit` before vite ever generates it, so a clone without it fails to type-check.
.tanstack/
.output/

# Stryker
reports/
.stryker-tmp/

# TLS certs for the https dev server. Never committed — the key is a private key.
certs/

# GitNexus index storage. The committed part is .gitnexusrc at the repo root.
.gitnexus/

# Qodana — scan results (SARIF + report), written by .githooks/pre-commit and pre-push.
# They pass --results-dir .qodana/results so the SARIF is readable from the repo root
# after a failed gate, rather than under ~/.cache/JetBrains/Qodana/<project-hash>/.
.qodana/
semgrep.sarif

# Core dumps. Qodana's JS language service aborts on its 1 GB heap cap inside the scan container,
# and while the host's core_pattern is relative the kernel drops a ~1.3 GB `core.<pid>` here in the
# repo root — untracked, unignored, and large enough that `prettier --check .` fails on it with
# "Invalid string length" and takes the whole commit gate down. qodana.sh sweeps them after every
# scan; this is the second lock, so a crash costs a diagnosis rather than a red gate.
core
core.*
